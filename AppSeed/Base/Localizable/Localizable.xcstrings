    "gpt_prompt_finalReminder": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your analysis ends with a clear and meaningful conclusion. Avoid leaving sentences incomplete or hanging."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizini tam ve anlamlı bir şekilde bitir. Lütfen eksik, yarım kalmış cümle bırakma."
          }
        }
      }
    },
    "gpt_prompt_jsonFormat": {
      "comment": "Instruction to respond with pure JSON in specific format",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only respond in **pure JSON**. Do not include any explanations, introductions, or text outside the JSON object. Use this exact format:\\n\\n  {\\n    \\\"message\\\": String,\\n    \\\"mainElements\\\": [String]\\n  }\\n\\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca aşağıdaki formatta saf JSON olarak yanıt ver. Açıklama, giriş veya JSON dışında herhangi bir metin ekleme:\\n\\n{\\n  \\\"message\\\": String,\\n  \\\"mainElements\\\": [String]\\n}\\n"
          }
        }
      }
    },
    "gpt_prompt_language": {
      "comment": "%@ is language name, e.g. Türkçe / English",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
