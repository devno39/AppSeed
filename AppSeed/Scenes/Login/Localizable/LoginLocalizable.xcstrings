      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in was cancelled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş iptal edildi."
          }
        }
      }
    },
